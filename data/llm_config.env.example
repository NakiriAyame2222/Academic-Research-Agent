# 研究 Agent 配置示例。复制为 llm_config.env 并填入你自己的值。
# （Web 设置面板保存时会重写 llm_config.env，本示例文件不受影响，可长期保留作参考。）

# ---- 对话 LLM ----
LLM_MODEL=gpt-4o-mini
API_KEY=sk-your-llm-key
BASE_URL=https://api.openai.com

# ---- 向量 embedding（默认复用上面的 LLM key/base_url，也可单独指定）----
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---- 使用 Gemini 的 embedding 模型 ----
# Gemini 提供 OpenAI 兼容端点，无需改代码，填以下三项即可：
#   EMBEDDING_MODEL=gemini-embedding-001
#   EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   EMBEDDING_API_KEY=<你的 Gemini API Key>
# 说明：gemini-embedding-001 默认输出 3072 维且已归一化，检索开箱即用。

# ---- 运行参数 ----
MAX_RESEARCH_ROUNDS=2
DEFAULT_TOP_K=4
PROXY=
